# Example Environment Variables for Smart Study Planner AI
# Copy this file to .env for local overrides or set these variables in the Render Dashboard.
# NEVER commit real secrets or database credentials to version control.

# Flask Environment: 'production' for live deployment, 'development' for local work
FLASK_ENV=production

# Strong random secret key for signing session cookies (minimum 32 bytes / 64 hex characters)
# Example generation command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-secret-key-min-32-characters

# Database connection URL (Render Managed PostgreSQL or external PostgreSQL)
# When omitted, the application defaults to local SQLite at instance/planner.db
DATABASE_URL=postgresql://username:password@hostname:5432/databasename

# Port configuration (automatically injected by Render in production)
PORT=10000

# Python unbuffered logging for real-time log streaming in Render console
PYTHONUNBUFFERED=1
